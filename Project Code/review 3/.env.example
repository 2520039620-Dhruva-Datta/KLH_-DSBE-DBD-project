# Copy to .env only when connecting your own MySQL server.
# npm run setup:local writes a separate .env automatically for the local instance.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amap
DB_USER=amap_app
DB_PASSWORD=replace-with-database-password
DB_SSL_CA=
CSRF_SECRET=replace-with-at-least-32-random-bytes-in-hex
SESSION_HOURS=8
# Use HTTPS and secure cookies in production. Local HTTP binds only to loopback.
COOKIE_SECURE=false
# Optional migration-only credentials; never used by the HTTP server.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace-with-migration-password
